@pix2 1.1
@grid
  cols: 1
  rows: 1
  default_cell: 4x4
@cell c
@layer l
  cell: c
  opacity: 0.5
@region below
  cell: c
  parent: l
  p 0,0 #0000ff
@group g
  cell: c
  parent: l
  opacity: .5
@region r
  cell: c
  parent: g
  opacity: 5e-1
  p 1,0 #ff000080
  p 0,0 #ff0000
@region above
  cell: c
  parent: l
  opacity: 0
  p 0,0 #00ff00
